+            faulted <= 0;
+            previous_enabled <= 0;
+            skip_pending <= 0;
+            skip_half <= 0;
+            next_owner <= 1;
+            engine_owner <= 0;
+            owners[0] <= 0;
+            owners[1] <= 0;
